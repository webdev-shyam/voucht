# ============================================================
# VOUCHT ENVIRONMENT
# Copy to .env.local for development. Never commit a real .env.
# ============================================================

# ------------------------------------------------------------
# PUBLIC — these are shipped to the browser. Put nothing secret here.
# ------------------------------------------------------------

# Supabase project (anon key is safe to expose only because Row Level
# Security decides what a caller may read; the app's dashboard relies on that)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin. Used for Open Graph URLs, verification links and
# payment redirects. In production this must be https://www.voucht.tech — the
# apex answers with a 308 to www, and a webhook or IPN posted to a host that
# redirects gets dropped rather than followed. It must also match the Site URL
# set in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# SERVER ONLY — reading these from client code is a security incident.
# ------------------------------------------------------------

# Bypasses RLS. Server components and route handlers only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI contract drafts. Optional: the feature reports itself as unavailable
# rather than inventing a contract when unset.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Transactional email. The sender addresses in src/lib/email.ts are on
# voucht.tech, so this domain must be DNS-verified at Resend first.
RESEND_API_KEY=

# CREEM subscriptions. Checkout needs the API key plus a product id per plan:
# CREEM_PRODUCT_ID_PRO alone enables Pro card checkout, and Elite needs its own
# id. A plan with no id reports itself unavailable instead of opening a
# checkout that cannot be paid. The webhook needs the signing secret. Without
# these, billing reports that payments are unavailable rather than pretending a
# purchase happened.
CREEM_API_KEY=
CREEM_PRODUCT_ID_PRO=
CREEM_PRODUCT_ID_ELITE=
CREEM_WEBHOOK_SECRET=
# Test keys start with "creem_test_" and are detected automatically. Set this
# only if you are using a production-shaped key against the test host.
CREEM_TEST_MODE=false
# Optional override of https://api.creem.io/v1 / https://test-api.creem.io/v1.
CREEM_API_BASE=

# NOWPayments crypto payments. Needs the API key and the IPN secret; a key
# whose value is still "true"/blank counts as unset. Leave SANDBOX=false unless
# you are deliberately testing: NOWPAYMENTS_SANDBOX=true sends a live API key to
# the sandbox host, which rejects it, and the checkout then fails with a message
# that says nothing about the cause.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Protects /api/cron/check-milestones. Vercel sends it as
# "Authorization: Bearer <secret>". Without this the endpoint is a public GET
# that emails every user, so it must be set before the cron is enabled.
CRON_SECRET=

# Rotates the daily one-way hash of the visitor IP used to count proof page
# views. Visitor IPs are never stored. Generate one: `openssl rand -hex 32`.
PROFILE_VIEW_HASH_SECRET=

# Server-only mirror of NEXT_PUBLIC_APP_URL for provider callbacks.
APP_URL=http://localhost:3000
